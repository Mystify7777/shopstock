# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (free tier target — PRD §40)
# Put the DATABASE NAME in the path (here: shopstock). Without one the driver uses a
# database called "test". Replace <user> and <password> with real values and no angle
# brackets; URL-encode special characters in the password (@ : / ? # % and so on).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopstock

# Server
PORT=4000
NODE_ENV=development

# Auth (PRD §33-§35)
# In production (NODE_ENV=production) the server refuses to start unless this is at
# least 32 characters and not a "change-me" placeholder. Generate one with:
#   node -p "crypto.randomBytes(48).toString('base64url')"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=90

# Initial single-account credentials (used only by the seed script to
# create the one shop account — PRD §33: single account, no multi-user)
SEED_USERNAME=shopowner
SEED_PASSWORD=change-me-before-seeding

# CORS — the origin(s) your frontend is served from. Comma-separated for more
# than one (here: the Vite dev server and the production preview build). Each
# entry must be exactly scheme://host[:port]: no trailing slash, path or wildcard.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional: how many reverse proxies sit between the internet and this server (a
# whole number, 0 or more). Leave it blank when the server is reached directly: no
# proxy is trusted and nothing changes. Behind a hosting platform's proxy, set the
# real number of hops so the login/refresh rate limiter counts each client on its own;
# left blank, every client behind the proxy shares one limit. Too high a number lets a
# client spoof its address, so do not guess: see docs/DEPLOYMENT.md.
TRUST_PROXY=

# Optional: object storage for product photos on sync (see docs/ARCHITECTURE.md
# assumption #3). Leave blank to skip photo sync until configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
