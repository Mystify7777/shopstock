# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string (free tier target — PRD §40)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopstock

# Server
PORT=4000
NODE_ENV=development

# Auth (PRD §33-§35)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=90

# Initial single-account credentials (used only by the seed script to
# create the one shop account — PRD §33: single account, no multi-user)
SEED_USERNAME=shopowner
SEED_PASSWORD=change-me-before-seeding

# CORS — the origin(s) your frontend is served from. Comma-separated for more
# than one (here: the Vite dev server and the production preview build). Each
# entry must be exactly scheme://host[:port]: no trailing slash, path or wildcard.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional: object storage for product photos on sync (see docs/ARCHITECTURE.md
# assumption #3). Leave blank to skip photo sync until configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
