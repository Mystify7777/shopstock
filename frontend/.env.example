# Frontend build-time configuration. Copy this file to .env.local (or set the same
# variable in your host's build settings) and fill it in. Never commit .env files.
#
# Vite inlines VITE_* values when the app is BUILT, not when it runs: change the
# value, then rebuild (`npm run build`). It is read in src/main.jsx.

# Origin of the ShopStock API: scheme://host[:port]. No trailing slash and no path;
# requests are sent to `${VITE_API_BASE_URL}/api/...`.
#
#   Empty or unset  Same origin: the app calls `/api/...` on the host that serves it.
#                   Use this when the API is behind the same host or a reverse proxy.
#   A full origin   The API is on another origin, for example a local backend while
#                   developing: http://localhost:4000
#                   There is no dev proxy, so the backend's CORS_ORIGIN
#                   (backend/.env.example) must list the origin the app is served
#                   from, for example http://localhost:5173.
VITE_API_BASE_URL=
